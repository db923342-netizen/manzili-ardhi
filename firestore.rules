rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'db923342@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /properties/{propertyId} {
      // Anyone can view approved properties. Owners and admins can view any property.
      allow read: if resource.data.status == 'approved' || (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()));
      // Authenticated users can submit a property
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Property owner or admin can update
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Property owner or admin can delete
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /temporary_bookings/{bookingId} {
      // Anyone can create a temporary apartment booking request
      allow create: if true;
      // Admin, or the authenticated creator can view and manage the booking
      allow read, update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /temporary_rentals/{rentalId} {
      // Anyone can read active temporary rental listings
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}

